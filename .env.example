# 端口
PORT=5000

# 大模型配置
MODEL_PROVIDER=SILICONFLOW

# 硅基流动
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=moonshotai/Kimi-K2.7-Code
# 多模态分类/抽取（需支持 Vision）
# 需选用账号可用的 VL 对话模型（编辑类模型不可用）
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 可选：最终对话轮也把原图发给主模型（主模型需支持视觉）
# ATTACH_IMAGES_TO_CHAT=1

# 可选：有图时先跑 Vision「分类 + 抽取」结构化管线（默认关闭，直接把原图交给 VL）
# ENABLE_SCENE_PIPELINE=1

# 上下文窗口 / Token 预算（启发式估算，用于滑动窗口与摘要压缩）
# CONTEXT_MAX_TOKENS=32000
# CONTEXT_RESERVE_RESPONSE=2048
# CONTEXT_RESERVE_SYSTEM=3000
# 设为 0 可关闭旧消息 LLM 摘要（仅滑动窗口）
# CONTEXT_ENABLE_SUMMARY=1

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 可选：Nominatim 回退（逆地理 / 正向地理编码）User-Agent
# NOMINATIM_USER_AGENT=travel-recommend-h5/1.0
